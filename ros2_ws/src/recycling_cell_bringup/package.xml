<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recycling_cell_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files for the fake sorting cell</description>
  <maintainer email="rlack@todo.todo">rlack</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>recycling_cell_perception</exec_depend>
  <exec_depend>recycling_cell_manipulation</exec_depend>
  <exec_depend>recycling_cell_task_manager</exec_depend>
  <exec_depend>recycling_cell_moveit_manipulation</exec_depend>
  <exec_depend>recycling_cell_monitor</exec_depend>
  <exec_depend>recycling_cell_vision</exec_depend>
  <exec_depend>moveit_resources_panda_moveit_config</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
